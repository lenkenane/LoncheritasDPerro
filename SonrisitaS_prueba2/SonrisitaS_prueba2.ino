#define FRAMES_ARRAY   oled_1280x640_frames

#define FRAME_COUNT  (sizeof(FRAMES_ARRAY) / sizeof(FRAMES_ARRAY[0]))
#define FRAME_BYTES  (SCREEN_W * SCREEN_H / 8)

Adafruit_SSD1306 display(SCREEN_W, SCREEN_H, &Wire, OLED_RESET, I2C_CLOCK, I2C_CLOCK);

const uint32_t FRAME_INTERVAL_US = 1000000UL / TARGET_FPS;
uint32_t frameIndex = 0;
uint32_t nextFrameUs = 0;

static inline void loadFrame(const uint8_t *frame) {
  uint8_t *buf = display.getBuffer();

#if FRAME_FORMAT == 1
  memcpy_P(buf, frame, FRAME_BYTES);
#else
  memset(buf, 0, FRAME_BYTES);
  for (uint8_t y = 0; y < SCREEN_H; y++) {
    const uint8_t mask = 1 << (y & 7);
    uint8_t *dstRow = buf + (y >> 3) * SCREEN_W;
    const uint8_t *src = frame + y * (SCREEN_W / 8);
    for (uint8_t bx = 0; bx < SCREEN_W / 8; bx++) {
      uint8_t b = pgm_read_byte(src + bx);
      if (!b) continue;
      uint8_t *d = dstRow + (bx << 3);
      if (b & 0x80) d[0] |= mask;
      if (b & 0x40) d[1] |= mask;
      if (b & 0x20) d[2] |= mask;
      if (b & 0x10) d[3] |= mask;
      if (b & 0x08) d[4] |= mask;
      if (b & 0x04) d[5] |= mask;
      if (b & 0x02) d[6] |= mask;
      if (b & 0x01) d[7] |= mask;
    }
  }
#endif

#if INVERT_COLORS
  for (uint16_t i = 0; i < FRAME_BYTES; i++) buf[i] = ~buf[i];
#endif
}

void setup() {
#if DEBUG_FPS
  Serial.begin(115200);
#endif

  Wire.begin(PIN_SDA, PIN_SCL);
  Wire.setClock(I2C_CLOCK);

  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
#if DEBUG_FPS
    Serial.println("ERROR: SSD1306 no encontrado. Revisa cableado/direccion.");
#endif
    while (true) delay(1000);
  }

  display.clearDisplay();
  display.display();

#if DEBUG_FPS
  Serial.printf("Frames: %u | FPS objetivo: %u\n", (unsigned)FRAME_COUNT, TARGET_FPS);
#endif

  nextFrameUs = micros();
}

void loop() {
  uint32_t now = micros();
  if ((int32_t)(now - nextFrameUs) < 0) return;

  loadFrame((const uint8_t *)FRAMES_ARRAY[frameIndex]);
  display.display();

  nextFrameUs += FRAME_INTERVAL_US;
  frameIndex++;

#if DROP_FRAMES
  now = micros();
  while ((int32_t)(now - nextFrameUs) >= (int32_t)FRAME_INTERVAL_US) {
    nextFrameUs += FRAME_INTERVAL_US;
    frameIndex++;
  }
#endif

  if (frameIndex >= FRAME_COUNT) frameIndex %= FRAME_COUNT;

#if DEBUG_FPS
  static uint32_t fpsCount = 0, fpsTimer = millis();
  fpsCount++;
  if (millis() - fpsTimer >= 1000) {
    Serial.printf("FPS reales: %u\n", (unsigned)fpsCount);
    fpsCount = 0;
    fpsTimer = millis();
  }
#endif
}
